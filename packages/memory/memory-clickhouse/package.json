{
  "name": "@deepseek-ai/dsh-memory-clickhouse",
  "description": "Cold memory tier over ClickHouse: the append-only session history at data-centre scale",
  "version": "1.0.0",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {

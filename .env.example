# VEXER Agent — environment configuration
#
# Copy this file to `.env` and fill in the values you need:
#
#     cp .env.example .env
#
# `.env` is ignored by Git (see `.gitignore`). NEVER commit real credentials.
# Every value below is a placeholder. Replace it with your own key from the
# provider you actually use.
#
# The root `.env` is loaded by the test runners (vitest.e2e.config.ts,
# vitest.snapshot.config.ts, vitest.web.config.ts) via `process.loadEnvFile()`.
# The application runtime reads provider credentials from `process.env` and
# from the credential store under `$DSH_HOME` — see `docs/` and SECURITY.md.

# ---------------------------------------------------------------------------
# Provider credentials
# ---------------------------------------------------------------------------
# VEXER supports 40+ model providers. You only need ONE to get started.
# The primary provider used by the real-API test and demo suites:
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional override for the DeepSeek-compatible endpoint:
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Alternative providers (enable whichever you have a key for):
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
XAI_API_KEY=your_xai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
TOGETHER_API_KEY=your_together_api_key_here
FIREWORKS_API_KEY=your_fireworks_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here

# The authoritative provider → environment-variable catalog is generated at
# packages/llm/llm-pi-ai/src/provider-data.generated.ts (regenerate with
# `pnpm run gen-provider-data`). Consult it before adding a new provider.

# ---------------------------------------------------------------------------
# Runtime paths and behaviour
# ---------------------------------------------------------------------------
# Harness home: profiles, sessions, credentials, and plugin state live here.
# Defaults to `~/.dsh` when unset.
# DSH_HOME=

# Agent home for agent-authored instructions and skills.
# DSH_AGENTS_HOME=

# Set to `1` to disable outbound telemetry entirely. Recommended for CI and
# for anyone who does not want usage reporting.
DSH_TELEMETRY_DISABLED=1

# Port used by the container entrypoint (`docker-entrypoint.sh`) when
# VEXER_PORT is set. The CLI also accepts `--port`.
VEXER_PORT=7090

# ---------------------------------------------------------------------------
# Build metadata
# ---------------------------------------------------------------------------
# `pnpm run build:artifacts` embeds a short commit hash in browser artifacts.
# In a Git checkout this is read from `git rev-parse HEAD`. Set it explicitly
# when building from a source archive that has no Git metadata:
# DSH_CLIENT_COMMIT_HASH=0000000

# ---------------------------------------------------------------------------
# Optional integration services
# ---------------------------------------------------------------------------
# These are only required if you enable the corresponding optional plugins.
# Leave them unset for a standard single-machine install.
#
# MEMORY_REDIS_URL=redis://localhost:6379
# MEMORY_CLICKHOUSE_URL=http://localhost:8123
# KAFKA_BROKERS=localhost:9092
# NUTCH_REST_URL=http://localhost:8983
# SPARK_MASTER_URL=spark://localhost:7077
